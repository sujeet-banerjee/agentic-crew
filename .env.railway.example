# Reference only. Do not commit real credentials or a populated .env.railway.
# In Railway, set variables on the corresponding service in its Variables tab.
# Generate fresh cloud secrets; do not reuse local deployment secrets.

# n8n service
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
N8N_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_64_HEX_CHAR_SECRET

# postgres service (initial database is for n8n)
POSTGRES_DB=n8n
POSTGRES_USER=agentic_crew
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_URL_SAFE_PASSWORD

# redis service
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_REDIS_PASSWORD

# qdrant service
QDRANT_API_KEY=REPLACE_WITH_UNIQUE_QDRANT_API_KEY

# litellm service. Create the separate litellm database after PostgreSQL starts.
# Use the same PostgreSQL user, but a different database name.
LITELLM_MASTER_KEY=sk-REPLACE_WITH_UNIQUE_RANDOM_SECRET
LITELLM_DATABASE_URL=postgresql://agentic_crew:REPLACE_ME@postgres.railway.internal:5432/litellm

# Provider credentials required by the selected LiteLLM models
OPENAI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Railway platform setting for the LiteLLM service if the imported Compose
# build configuration does not automatically select the custom Dockerfile:
# RAILWAY_DOCKERFILE_PATH=Dockerfile.litellm

# Add this custom domain to the n8n Railway service:
N8N_PUBLIC_HOST=my.n8n.ai-maestro.in
