# NOTE: This is an example .env file. Copy this to a new file named .env and 
# fill in the values. An alternative is to set these values in your environment 
# variables (which could be passed on from your Github Actions workflow, or 
# Codespace Security settings).
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change_this_password

# --- LITELLM API KEYS ---
# Set this to the same value as your LITELLM_MASTER_KEY in the .env file
# in the production environment. This is used to secure the LiteLLM API.
# LITELLM_MASTER_KEY=sk-xxxxxx
GENERIC_TIMEZONE=Asia/Kolkata
OPENAI_API_KEY="sk-proj-your-actual-api-key-here"
TAVILY_API_KEY="tvly-your-tavily-key"

# --- NEW OPS VARIABLES For OTEL from LiteLLM to LangFuse ---
# Get it from your LangFuse account settings. This is 
# the secret key for your LangFuse project.
LANGFUSE_SECRET_KEY="sk-lf-******"
LANGFUSE_PUBLIC_KEY="pk-lf-******"
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"
LANGFUSE_HOST="https://jp.cloud.langfuse.com"
# LANGFUSE_DEBUG=True
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_PROJECT="Curriculum_Capstone_Prod"